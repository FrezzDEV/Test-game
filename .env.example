# Telegram user account (Telethon)
TG_API_ID=
TG_API_HASH=
TG_SESSION=giveaway_auto_join
TG_SESSION_DIR=./sessions
TG_PHONE=
TG_2FA_PASSWORD=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_MIN_CONFIDENCE=0.85

# Telegram admin bot (Bot API)
TG_BOT_TOKEN=
ADMIN_CHAT_ID=
ADMIN_USER_IDS=

# PostgreSQL
DATABASE_URL=

# Monitoring
MONITORED_CHANNELS=
AUTO_JOIN_ENABLED=false
SCAN_OLD_MESSAGES=false
TIMEZONE=Europe/Kyiv
LOG_LEVEL=INFO

# Predefined action/write sequences
ACTION_SEQUENCES_PATH=./config/action_sequences.json

# All *.session files inside TG_SESSION_DIR are loaded as user accounts.
# New and edited broadcast-channel posts are analyzed.
# Linked discussion groups / ordinary chats are ignored.

# Account fan-out: 0 = simultaneous, 250 = 250 ms stagger.
ACCOUNT_ACTION_DELAY_MS=250

# Notifications / reminders
NOTIFY_ON_WIN=true
NOTIFY_ON_REPLY=true
NOTIFY_ON_MENTION=true
REMINDER_INTERVAL_MINUTES=30
